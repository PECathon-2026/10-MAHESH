
{
  "manifest_version": 3,
  "name": "PrivacyLens",
  "description": "Privacy-Preserving Browser Vision Agent — local vision + PII redaction → sanitized context → server VLM → browser actions",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "1.png",
      "48": "1.png",
      "128": "1.png"
    }
  },
  "icons": {
    "16": "1.png",
    "48": "1.png",
    "128": "1.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
